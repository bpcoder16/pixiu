{
  "settings": {
    "analysis": {
      "analyzer": {
        "px_qt_v1_contains": {
          "filter": [
            "lowercase"
          ],
          "tokenizer": "px_qt_v1_trigram",
          "type": "custom"
        },
        "px_qt_v1_contains_unigram": {
          "filter": [
            "lowercase"
          ],
          "tokenizer": "px_qt_v1_unigram",
          "type": "custom"
        },
        "px_qt_v1_standard_index": {
          "filter": [
            "lowercase"
          ],
          "tokenizer": "standard",
          "type": "custom"
        },
        "px_qt_v1_standard_search_synonyms": {
          "filter": [
            "lowercase",
            "px_qt_v1_synonyms"
          ],
          "tokenizer": "standard",
          "type": "custom"
        }
      },
      "filter": {
        "px_qt_v1_synonyms": {
          "lenient": false,
          "synonyms_path": "analysis/search-synonyms.txt",
          "type": "synonym_graph",
          "updateable": true
        }
      },
      "tokenizer": {
        "px_qt_v1_trigram": {
          "max_gram": 3,
          "min_gram": 3,
          "token_chars": [],
          "type": "ngram"
        },
        "px_qt_v1_unigram": {
          "max_gram": 1,
          "min_gram": 1,
          "token_chars": [],
          "type": "ngram"
        }
      }
    },
    "number_of_replicas": 1,
    "number_of_shards": 6
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "es_update_at": {
        "doc_values": true,
        "format": "yyyy-MM-dd HH:mm:ss||strict_date_optional_time||epoch_millis",
        "index": false,
        "type": "date"
      },
      "query_text": {
        "analyzer": "px_qt_v1_standard_index",
        "fields": {
          "contains": {
            "analyzer": "px_qt_v1_contains",
            "norms": false,
            "search_analyzer": "px_qt_v1_contains",
            "type": "text"
          },
          "contains_unigram": {
            "analyzer": "px_qt_v1_contains_unigram",
            "norms": false,
            "search_analyzer": "px_qt_v1_contains_unigram",
            "type": "text"
          }
        },
        "search_analyzer": "px_qt_v1_standard_search_synonyms",
        "type": "text"
      }
    }
  }
}
